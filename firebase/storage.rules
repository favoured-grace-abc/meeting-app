rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Audio recordings: /recordings/{meetingId}/{recordingId}.{ext}
    match /recordings/{meetingId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 500 * 1024 * 1024; // 500MB max
      allow delete: if request.auth != null;
    }

    // Transcripts: /transcripts/{meetingId}/{recordingId}.json
    match /transcripts/{meetingId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // User avatars: /avatars/{userId}/{fileName}
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024; // 5MB max
      allow delete: if request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
