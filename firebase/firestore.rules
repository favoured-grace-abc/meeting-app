rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper Functions
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasRole(role) {
      return request.auth.token.roles != null
        && role in request.auth.token.roles;
    }

    function isMeetingParticipant(meetingId) {
      return exists(
        /databases/$(database)/documents/meetings/$(meetingId)/participants/$(request.auth.uid)
      );
    }

    // ============================================================
    // Users Collection
    // /users/{userId}
    // Schema:
    //   - displayName: string
    //   - email: string
    //   - photoURL: string (nullable)
    //   - createdAt: timestamp
    //   - lastSeen: timestamp
    //   - preferences: { theme: string, notifications: bool }
    // ============================================================
    match /users/{userId} {
      allow create: if isAuthenticated() && isOwner(userId);
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && (isOwner(userId) || hasRole('admin'));
    }

    // ============================================================
    // Meetings Collection
    // /meetings/{meetingId}
    // Schema:
    //   - title: string
    //   - description: string
    //   - hostId: string (ref: /users/{userId})
    //   - scheduledAt: timestamp (nullable, null = instant meeting)
    //   - startedAt: timestamp (nullable)
    //   - endedAt: timestamp (nullable)
    //   - status: string (enum: 'scheduled' | 'active' | 'ended')
    //   - roomName: string (LiveKit room name)
    //   - recordingEnabled: bool
    //   - maxParticipants: number
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //   - metadata: map (optional flexible fields)
    // ============================================================
    match /meetings/{meetingId} {
      allow create: if isAuthenticated()
        && request.resource.data.hostId == request.auth.uid;
      allow read: if isAuthenticated()
        && (resource.data.hostId == request.auth.uid
            || exists(
              /databases/$(database)/documents/meetings/$(meetingId)/participants/$(request.auth.uid)
            ));
      allow update: if isAuthenticated()
        && (resource.data.hostId == request.auth.uid || hasRole('admin'));
      allow delete: if isAuthenticated()
        && (resource.data.hostId == request.auth.uid || hasRole('admin'));

      // Participants subcollection
      // /meetings/{meetingId}/participants/{participantId}
      // Schema:
      //   - displayName: string
      //   - email: string
      //   - photoURL: string (nullable)
      //   - joinedAt: timestamp
      //   - leftAt: timestamp (nullable)
      //   - role: string (enum: 'host' | 'participant')
      //   - isMuted: bool
      //   - isVideoOn: bool
      match /participants/{participantId} {
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/meetings/$(meetingId)).data.hostId == request.auth.uid
              || isMeetingParticipant(meetingId));
        allow create: if isAuthenticated()
          && participantId == request.auth.uid;
        allow update, delete: if isAuthenticated()
          && participantId == request.auth.uid;
      }

      // Chat subcollection
      // /meetings/{meetingId}/messages/{messageId}
      // Schema:
      //   - senderId: string
      //   - senderName: string
      //   - content: string
      //   - timestamp: timestamp
      //   - type: string (enum: 'text' | 'system')
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isMeetingParticipant(meetingId);
        allow create: if isAuthenticated()
          && isMeetingParticipant(meetingId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid;
        allow delete: if false;
      }
    }

    // ============================================================
    // Recordings Collection
    // /recordings/{recordingId}
    // Schema:
    //   - meetingId: string (ref: /meetings/{meetingId})
    //   - hostId: string (ref: /users/{userId})
    //   - title: string
    //   - url: string (Cloud Storage URL)
    //   - transcriptUrl: string (nullable, Cloud Storage URL)
    //   - duration: number (seconds)
    //   - fileSize: number (bytes)
    //   - status: string (enum: 'processing' | 'ready' | 'failed')
    //   - aiSummary: string (nullable)
    //   - aiTranscription: string (nullable)
    //   - speakers: array of { id: string, name: string }
    //   - createdAt: timestamp
    //   - meetingTitle: string
    // ============================================================
    match /recordings/{recordingId} {
      allow create: if isAuthenticated()
        && request.resource.data.hostId == request.auth.uid;
      allow read: if isAuthenticated()
        && (resource.data.hostId == request.auth.uid
            || isMeetingParticipant(resource.data.meetingId));
      allow update: if isAuthenticated()
        && resource.data.hostId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.hostId == request.auth.uid || hasRole('admin'));
    }

    // ============================================================
    // Deny all other paths by default
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
