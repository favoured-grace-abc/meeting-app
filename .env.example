# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# LiveKit Configuration
VITE_LIVEKIT_API_KEY=your-livekit-api-key
VITE_LIVEKIT_API_SECRET=your-livekit-api-secret
VITE_LIVEKIT_SERVER_URL=wss://your-livekit-instance.com
VITE_LIVEKIT_TOKEN_SERVER=http://localhost:4000

# Live captions use the browser Web Speech API (no external STT/TTS/LLM needed)

# Meeting Recorder API (the .NET backend — this app has no server of its own).
# Optional: the deployed service below is the built-in default.
# Point this at http://localhost:5000 to run against a local MeetingRecorder.Api.
VITE_API_BASE_URL=https://meeting-recorder-backend-286455810620.europe-west1.run.app

# Set to "true" to force connecting to Firebase emulators even outside dev builds.
# In development the functions emulator is used automatically (no deploy needed;
# Cloud Functions require the Blaze plan to deploy).
# Only the functions emulator is wired in the web SDK (Firestore requires Java,
# which is not installed). Run it with:  npm run emulators
VITE_USE_EMULATORS=false
