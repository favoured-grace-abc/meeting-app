# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# LiveKit Configuration
VITE_LIVEKIT_API_KEY=your-livekit-api-key
VITE_LIVEKIT_API_SECRET=your-livekit-api-secret
VITE_LIVEKIT_SERVER_URL=wss://your-livekit-instance.com
VITE_LIVEKIT_TOKEN_SERVER=http://localhost:4000

# Live captions use the browser Web Speech API (no external STT/TTS/LLM needed)

# Meeting Recorder Backend API (local Node server — run with `npm run dev:server`)
# Swap in the hosted transcription service URL here if you do not run the local server:
# VITE_API_BASE_URL=https://meeting-recorder-backend-286455810620.europe-west1.run.app
VITE_API_BASE_URL=http://localhost:3001

# Backend server (server/index.js)
PORT=3001
SERVER_BASE_URL=http://localhost:3001
FIREBASE_PROJECT_ID=your-project-id
# Used to sign short-lived upload/download URLs
SIGNED_URL_SECRET=change-me
# Real Whisper transcription is done with the free Groq Whisper endpoint.
# Get a key at https://console.groq.com (no payment required).
GROQ_API_KEY=your-groq-api-key
# Legacy paid transcription source (used only if GROQ_API_KEY is not set).
# OPENAI_API_KEY=sk-...

# Set to "true" to force connecting to Firebase emulators even outside dev builds.
# In development the functions emulator is used automatically (no deploy needed;
# Cloud Functions require the Blaze plan to deploy).
# Only the functions emulator is wired in the web SDK (Firestore requires Java,
# which is not installed). Run it with:  npm run emulators
VITE_USE_EMULATORS=false
